; ============================================================================
; Memory map. Everything below is relative to these two symbols: to move the
; I/O page or the ROM change them here (and IO_START / ROM_START in
; include/mapper.h, emulator/memmap.py).
; ============================================================================
IOBASE     =        $8000               ; I/O page (256 bytes, page aligned)
ROMBASE    =        $8100               ; first ROM address (nothing is used below $C000 yet)
BASICBASE  =        $C000               ; BASIC interpreter

ledport    =        IOBASE+$00          ; LEDs (bits 0-2)
keyb       =        IOBASE+$01          ; keyboard
romctl     =        IOBASE+$04          ; ROM on/off: write 1 = ROM off (RAM), 0 = ROM on; read bit 7 = busy
abrddat    =        IOBASE+$02          ; Read data from 9918
abwrdat    =        IOBASE+$02          ; Write data to 9918
abwrreg    =        IOBASE+$03          ; Write 9918 control registers (read = status)

abpsgreg   =        IOBASE+$08          ; Write 8910 control registers
abpsgdat   =        IOBASE+$09          ;       8910 i/o

basadr     =        $06                 ; A pair of ZP addresses

ch         =        $24
cv         =        $25
basl       =        $28
bash       =        $29
bas2l      =        $2A
bas2h      =        $2B
h2         =        $2C
lmnem      =        $2C
v2         =        $2D
rmnem      =        $2D
mask       =        $2E
format     =        $2E
length     =        $2F
mode       =        $31
invflg     =        $32
prompt     =        $33
ysav       =        $34
ysav1      =        $35
cswl       =        $36
cswh       =        $37
kswl       =        $38
kswh       =        $39
pcl        =        $3A
pch        =        $3B
a1l        =        $3C
a1h        =        $3D
a2l        =        $3E
a2h        =        $3F
a3l        =        $40
a3h        =        $41
a4l        =        $42
a4h        =        $43
a5l        =        $44
a5h        =        $45
macstat    =        $44
acc        =        $45
xreg       =        $46
yreg       =        $47
status     =        $48
spnt       =        $49
rndl       =        $4E
rndh       =        $4F
bootdev    =        $4F
hcolor     =        $E4
ingmod     =        $EA
holda      =        $EB
xoff       =        $EC
yoff       =        $ED
tach       =        $EE                 ; Controls the cursor speed
csrphase   =        $EF
csrlin     =        $FA
tmpad1     =        $FC
tmpad2     =        $FE

in         =        $0200

paddr      =        $0300
pmask      =        $0302
pacc       =        $0303
px         =        $0304
py         =        $0305
pdata      =        $0306

resvec     =        $03F2               ; User reset vector
usradr     =        $03F8               ; User vector
usrirq     =        $03FE               ; User IRQ vector


; ============================================================================
; VDP frame interrupt (VSYNC).  The Pico sets the VDP frame flag 60 times a
; second; with bit 5 of VDP register 1 set it also pulls the CPU's /IRQ low
; until $8003 is read.  Assemble with -D VSYNC_IRQ=0 to build the old ROM
; (interrupt left off).  Free RAM used (BASIC: PEEK the decimal address):
;   vblcount  $03E0-$03E2   992-994  frame counter, 24 bit, low byte first
;   vdpflags  $03E3         995      VDP status bits collected since cleared:
;                                    128 frame, 64 fifth sprite, 32 collision
;   vbl_on    $03E4         996      non-zero: VDP 1,n keeps the interrupt bit
; ============================================================================
          .ifndef   VSYNC_IRQ
VSYNC_IRQ  =        1
          .endif
          .ifndef   STORAGE               ; 1: SAVE/LOAD/BSAVE/BLOAD/BRUN/CATALOG/ERASE/RENAME on the flash storage
STORAGE    =        1
          .endif
vblcount   =        $03E0
vdpflags   =        $03E3
vbl_on     =        $03E4
vbl_linnum =        $50                 ; same as LINNUM in fpp65.a65

          .pc02
          .org      ROMBASE

          .if       VSYNC_IRQ
; ----------------------------------------------------------------------------
; Cold start: set up the text mode (its register table has the interrupt bit
; set), throw away a stale frame flag and enable interrupts.
; ----------------------------------------------------------------------------
vbl_init: lda       #$00
          sta       vblcount
          sta       vblcount+1
          sta       vblcount+2
          sta       vdpflags
          lda       #$01
          sta       vbl_on
          jsr       initxt
          lda       abwrreg             ; discard a stale frame flag
          cli
          rts

; ----------------------------------------------------------------------------
; Hardware IRQ handler (jumped to through usrirq by the monitor's irq: stub,
; which has put A in acc and left X, Y alone).  The IRQ line is released a
; little AFTER the status read, so this is sometimes entered again with the
; frame flag clear: those entries are ignored.
; ----------------------------------------------------------------------------
vbl_irq:  lda       abwrreg             ; read + clear status, releases /IRQ
          and       #$E0                ; frame, 5th sprite, collision
          tsb       vdpflags            ; collect (TSB leaves N alone)
          bpl       @done               ; frame flag clear: empty entry
          inc       vblcount
          bne       @done
          inc       vblcount+1
          bne       @done
          inc       vblcount+2
@done:    lda       acc                 ; the stub saved A here
          rti

; ----------------------------------------------------------------------------
; Called by the BASIC VDP command in place of "stx abwrreg": keep the
; interrupt bit when register 1 is written (unless POKE 996,0).
; ----------------------------------------------------------------------------
vbl_vdpdo: lda      vbl_linnum          ; register number
          cmp       #$01
          bne       @write
          lda       vbl_on
          beq       @write
          txa
          ora       #$20
          tax
@write:   stx       abwrreg
          rts
          .endif

          .res      BASICBASE-*
          .include  "fpp65.a65"
          .if       STORAGE
          .include  "storage.a65"         ; fits into the gap between BASIC and the monitor
          .endif
          .res      $F000-*
          
font:     .byte     $00, $00, $00, $00, $00, $00, $00, $00
          .byte     $E0, $E0, $E0, $E0, $00, $00, $00, $00
          .byte     $1C, $1C, $1C, $1C, $00, $00, $00, $00
          .byte     $FC, $FC, $FC, $FC, $00, $00, $00, $00
          .byte     $00, $00, $00, $00, $E0, $E0, $E0, $E0
          .byte     $E0, $E0, $E0, $E0, $E0, $E0, $E0, $E0
          .byte     $1C, $1C, $1C, $1C, $E0, $E0, $E0, $E0
          .byte     $FC, $FC, $FC, $FC, $E0, $E0, $E0, $E0
          .byte     $00, $00, $00, $00, $1C, $1C, $1C, $1C
          .byte     $E0, $E0, $E0, $E0, $1C, $1C, $1C, $1C
          .byte     $1C, $1C, $1C, $1C, $1C, $1C, $1C, $1C
          .byte     $FC, $FC, $FC, $FC, $1C, $1C, $1C, $1C
