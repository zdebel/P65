          .byte     $20, $20, $20, $FC, $20, $20, $20, $20
          .byte     $20, $20, $20, $E0, $20, $20, $20, $20
          .byte     $20, $20, $20, $3C, $00, $00, $00, $00
          .byte     $20, $20, $20, $FC, $00, $00, $00, $00
          .byte     $20, $20, $20, $E0, $00, $00, $00, $00
          .byte     $00, $00, $00, $FC, $00, $00, $00, $00
          .byte     $00, $00, $70, $70, $70, $00, $00, $00
          .byte     $20, $70, $A8, $20, $20, $20, $20, $00
          .byte     $20, $20, $20, $20, $A8, $70, $20, $00
