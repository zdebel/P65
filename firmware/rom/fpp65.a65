   .WORD RESUME-1     ;$A6..@166...RESUME
   .WORD L3ERR-1     ;$A7..@167...RECALL
   .WORD L3ERR-1      ;$A8..@168...STORE
   .WORD REM-1        ; used for ELSE
   .WORD LET-1        ;$AA_.@170...LET
   .WORD GOTO-1       ;$AB..@171...GOTO
   .WORD RUN-1        ;$AC_.@172...RUN
   .WORD IF-1         ;$AD_.@173...IF
