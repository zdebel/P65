   .WORD sto_erase-1   ;$8F..@143...ERASE   (was VLIN)
   .else
   .WORD L3ERR-1       ;$8E..@142...HLIN
   .WORD L3ERR-1       ;$8F..@143...VLIN
   .endif
   .else
   .WORD L3ERR-1       ;$8E..@142...HLIN
