   .if STORAGE
   .BYTE "RENAM",'E'+128     ;$98..@152 (was ROT=)
   .BYTE "BRU",'N'+128       ;$99..@153 (was SCALE=)
   .else
   .BYTE "ROT",'='+128       ;$98..@152
   .BYTE "SCALE",'='+128     ;$99..@153
   .endif
   .else
   .BYTE "ROT",'='+128       ;$98..@152
   .BYTE "SCALE",'='+128     ;$99..@153
   .endif
   .BYTE "SWA",'P'+128       ;$9A_.@154
   .BYTE "TRAC",'E'+128      ;$9B..@155
