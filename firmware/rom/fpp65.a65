   .WORD sto_brun-1    ;$99..@153...BRUN   (was SCALE=)
   .else
   .WORD L3ERR-1        ;$98..@152...ROT=
   .WORD L3ERR-1      ;$99..@153...SCALE=
   .endif
   .else
   .WORD L3ERR-1        ;$98..@152...ROT=
