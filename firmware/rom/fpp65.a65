;--------------------------------
;      MATH OPERATOR BRANCH TABLE
;
;      ONE-BYTE PRECEDENCE CODE
;      TWO-BYTE ADDRESS
;--------------------------------
P_OR    =  $46      ;"OR" IS LOWEST PRECEDENCE
P_AND   =  $50
P_REL   =  $64      ;RELATIONAL OPERATORS
P_ADD   =  $79      ;BINARY + AND -
P_MUL   =  $7B      ;* AND /
P_PWR   =  $7D      ;EXPONENTIATION
P_NEQ   =  $7F      ;UNARY - AND COMPARISON =
;--------------------------------
MATHTBL:
       .BYTE P_ADD
       .WORD FADDT-1  ;$C8..@200...+
       .BYTE P_ADD
       .WORD FSUBT-1  ;$C9..@201...-
       .BYTE P_MUL
       .WORD FMULTT-1 ;$CA_.@202...;
       .BYTE P_MUL
       .WORD FDIVT-1  ;$CB..@203.../
       .BYTE P_PWR
       .WORD FPWRT-1  ;$CC_.@204...^
       .BYTE P_AND
       .WORD AND_-1    ;$CD_.@205...AND
       .BYTE P_OR
       .WORD OR-1      ;$CE..@206.._OR
M_NEG: .BYTE P_NEQ
       .WORD NEGOP-1  ;$CF..@207...>
M_EQU: .BYTE P_NEQ
       .WORD EQUOP-1  ;$D0..@208...=
M_REL: .BYTE P_REL
       .WORD RELOPS-1 ;$D1..@209...<
;--------------------------------
;      TOKEN NAME TABLE
;--------------------------------
TOKEN_NAME_TABLE: ;uso: add 128 on last byte of sequence.
   .BYTE "EN",'D'+128        ;$80..@128
   .BYTE "FO",'R'+128        ;$81..@129
   .BYTE "NEX",'T'+128       ;$82..@130
   .BYTE "DAT",'A'+128       ;$83..@131
   .BYTE "INPU",'T'+128      ;$84..@132
   .BYTE "DE",'L'+128        ;$85..@133
   .BYTE "DI",'M'+128        ;$86..@134
   .BYTE "REA",'D'+128       ;$87..@135
   .BYTE "HG",'R'+128        ;$88..@136
   .BYTE "TEX",'T'+128       ;$89..@137
   .BYTE "BLOA",'D'+128        ;$8A_.@138
   .BYTE "BSAV",'E'+128        ;$8B..@139
   .BYTE "CAL",'L'+128       ;$8C_.@140
   .BYTE "PLO",'T'+128       ;$8D_.@141
   .ifdef STORAGE
   .if STORAGE
   .BYTE "CATALO",'G'+128    ;$8E..@142 (was HLIN)
   .BYTE "ERAS",'E'+128      ;$8F..@143 (was VLIN)
   .else
   .BYTE "HLI",'N'+128       ;$8E..@142
   .BYTE "VLI",'N'+128       ;$8F..@143
   .endif
   .else
   .BYTE "HLI",'N'+128       ;$8E..@142
   .BYTE "VLI",'N'+128       ;$8F..@143
   .endif
   .BYTE "HCOLOR",'='+128    ;$92..@146
   .BYTE "HPLO",'T'+128      ;$93..@147
   .BYTE "DRA",'W'+128       ;$94..@148
   .BYTE "WPOK",'E'+128      ;$95..@149
   .BYTE "HTA",'B'+128       ;$96..@150
   .BYTE "HOM",'E'+128       ;$97..@151
