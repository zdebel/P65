   .BYTE "VD",'P'+128
   .BYTE "VPOK",'E'+128
   .BYTE "PRIN",'T'+128      ;$BA_.@186
   .BYTE "CON",'T'+128       ;$BB..@187
   .BYTE "LIS",'T'+128       ;$BC_.@188
   .BYTE "CLEA",'R'+128      ;$BD_.@189
   .BYTE "GE",'T'+128        ;$BE..@190
   .BYTE "NE",'W'+128        ;$BF..@191
   .BYTE "TAB",'('+128       ;$C0..@192
   .BYTE "T",'O'+128         ;$C1..@193
